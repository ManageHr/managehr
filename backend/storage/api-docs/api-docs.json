{
    "openapi": "3.0.0",
    "info": {
        "title": "ManageHR API",
        "description": "Documentación de la API RESTful de ManageHR desarrollada en Laravel con autenticación JWT",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "Servidor principal"
        }
    ],
    "paths": {
        "/api/perfil": {
            "get": {
                "tags": [
                    "Perfil"
                ],
                "summary": "Obtener el perfil del usuario autenticado",
                "description": "Retorna los datos del perfil con tipo de documento y género.",
                "operationId": "de5a6c590ae3c5b9aeed65506223c7ea",
                "responses": {
                    "200": {
                        "description": "Perfil encontrado con éxito",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "nombre": {
                                            "type": "string",
                                            "example": "Sharón"
                                        },
                                        "apellido": {
                                            "type": "string",
                                            "example": "López"
                                        },
                                        "email": {
                                            "type": "string",
                                            "example": "sharon@example.com"
                                        },
                                        "tipoDocumento": {
                                            "properties": {
                                                "nombre": {
                                                    "type": "string",
                                                    "example": "Cédula de Ciudadanía"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "genero": {
                                            "properties": {
                                                "nombre": {
                                                    "type": "string",
                                                    "example": "Femenino"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Usuario no autenticado"
                    },
                    "404": {
                        "description": "Perfil no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Perfil"
                ],
                "summary": "Actualizar el perfil del usuario autenticado",
                "description": "Permite actualizar información básica del perfil del usuario.",
                "operationId": "ddbd1b94f884c8776b0a5e9b831f0e39",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "usuario@example.com"
                                    },
                                    "direccion": {
                                        "type": "string",
                                        "example": "Calle 123 #45-67"
                                    },
                                    "telefono": {
                                        "type": "string",
                                        "example": "3001234567"
                                    },
                                    "numHijos": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "contactoEmergencia": {
                                        "type": "string",
                                        "example": "Juan Pérez"
                                    },
                                    "numContactoEmergencia": {
                                        "type": "string",
                                        "example": "3123456789"
                                    },
                                    "estadoCivilId": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Perfil actualizado con éxito"
                    },
                    "401": {
                        "description": "Usuario no autenticado"
                    },
                    "404": {
                        "description": "Perfil no encontrado"
                    },
                    "422": {
                        "description": "Datos inválidos enviados"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/mis-postulaciones": {
            "get": {
                "tags": [
                    "Postulaciones"
                ],
                "summary": "Obtener postulaciones del usuario autenticado",
                "description": "Devuelve las postulaciones realizadas por el usuario autenticado, incluyendo los datos de la vacante.",
                "operationId": "ae4c328250661c7b80991190875d49d9",
                "responses": {
                    "200": {
                        "description": "Postulaciones obtenidas correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Usuario no autenticado o sin número de documento",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Usuario no autenticado o sin número de documento."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Error interno al obtener las postulaciones",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Ocurrió un error al obtener tus postulaciones."
                                        },
                                        "error": {
                                            "type": "string",
                                            "example": "Detalle del error"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/horasextra": {
            "get": {
                "tags": [
                    "Horas Extra"
                ],
                "summary": "Listar todas las solicitudes de horas extra",
                "description": "Retorna un listado de todas las horas extra con sus relaciones.",
                "operationId": "7ac5641385d0ed59b1370aac3b05f96d",
