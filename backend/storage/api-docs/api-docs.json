                "summary": "Crear una nueva solicitud de horas extra",
                "description": "Registra una nueva solicitud de horas extra.",
                "operationId": "7640040408392c8efb7e377fd7fd8591",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "descrip",
                                    "fecha",
                                    "nHorasExtra",
                                    "tipoHorasid",
                                    "contratoId"
                                ],
                                "properties": {
                                    "descrip": {
                                        "type": "string",
                                        "maxLength": 500,
                                        "example": "Apoyo en evento institucional"
                                    },
                                    "fecha": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2025-07-06"
                                    },
                                    "nHorasExtra": {
                                        "type": "number",
                                        "example": 3
                                    },
                                    "tipoHorasid": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "contratoId": {
                                        "type": "integer",
                                        "example": 5
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Horas extra creada correctamente"
                    },
                    "400": {
                        "description": "Error de validación"
                    },
                    "500": {
                        "description": "Error interno del servidor"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
